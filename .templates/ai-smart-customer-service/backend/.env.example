# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# AI Chat: TokenHub (OpenAI-compatible)
# In the Genie sandbox this works with ZERO configuration: requests are routed
# through the sandbox proxy and the gateway injects real credentials for you.
# No variables below are required to run inside the sandbox.
#
# To use your own TokenHub credentials, uncomment and fill in the values.
# NEVER commit real credentials.
# TOKENHUB_API_KEY=your-tokenhub-api-key
# TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1

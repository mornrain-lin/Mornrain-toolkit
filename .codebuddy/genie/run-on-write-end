#!/bin/bash

# ============================================================================
# run-on-write-end
# SessionWriteEnd hook 包装脚本：仅在 JSONL 完整写盘（status=success）时执行 export-ppt。
#
# 为什么需要包装：
#   export-ppt 把 slide-*.js 渲染为 PDF，强依赖所有 slide 文件已落盘。
#   SessionWriteEnd payload 的 data.status 有三种：
#     - success：JSONL 写盘完成 → 执行 export-ppt（保证不漏页）
#     - timeout：1s 内未检测到完成行 → 跳过（slide 可能未写完，避免渲染不完整 PDF）
#     - cancelled：用户取消/中断 → 跳过
#
# 用法（settings/manifest hook command）：
#   ./.codebuddy/genie/run-on-write-end "<PLUGIN_ROOT>" "<PROJECT_DIR>"
#
# stdin：SessionWriteEnd payload JSON，含 data.status。
# 始终 exit 0（非阻断）。
# ============================================================================

PLUGIN_ROOT="${1:-.codebuddy}"
PROJECT_DIR="${2:-${CODEBUDDY_PROJECT_DIR:-.}}"

INPUT=$(cat 2>/dev/null)
STATUS=$(echo "$INPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('data',{}).get('status',''))" 2>/dev/null)

# 仅 success 才执行（timeout / cancelled 时 slide 可能未写完，跳过）
if [ "$STATUS" != "success" ]; then
    exit 0
fi

node "$PLUGIN_ROOT/skills/ppt-implement/scripts/export-ppt.js" "$PLUGIN_ROOT" "$PROJECT_DIR" > /dev/null 2>&1

exit 0
